# Copy to .env only if you need to change a default. Every setting is optional.

# Line recognizer (local). qwen3vl-fa is the default and the best measured engine.
OCR_ENGINE=qwen3vl-fa
# QWEN_MODEL=mohajesmaeili/Qwen3-VL-2B-Persian-Arabic-Ocr-v1.0

# Privacy: 0 = images never leave this machine (default). 1 = send crops to the
# OpenAI-compatible API below instead of the local model.
OCR_ALLOW_REMOTE=0
# VLM_API_BASE=https://api.openai.com/v1
# VLM_API_KEY=
# VLM_MODEL=gpt-4o-mini

# Optional post-correction through a LOCAL Ollama server (ollama pull qwen3:8b).
OCR_POST_CORRECT=0
# CORRECTOR_BASE_URL=http://localhost:11434
# CORRECTOR_MODEL=qwen3:8b

# Crops larger than this many pixels are downscaled before recognition.
# OCR_MAX_PIXELS=1000000
